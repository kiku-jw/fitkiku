      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Блог в Telegram"
          }
        }
      }
    },
    "The FitKiku server is currently unreachable.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер FitKiku сейчас недоступен."
          }
        }
      }
    },
    "The FitKiku server rejected the request (HTTP %@).": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер FitKiku отклонил запрос (HTTP %@)."
          }
        }
      }
    },
    "The FitKiku server returned an invalid response.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер FitKiku вернул некорректный ответ."
          }
        }
      }
    },
    "The link will stop working immediately. Your iPhone remains connected to FitKiku.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылка перестанет работать сразу. Ваш iPhone останется подключён к FitKiku."
          }
        }
      }
    },
    "The native health client is unavailable.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Системный клиент данных о здоровье недоступен."
          }
        }
      }
    },
    "The old link will stop working immediately. Chats that saved it will need the new prepared message.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Старая ссылка сразу перестанет работать. В чаты, где она сохранена, нужно будет отправить новое готовое сообщение."
          }
        }
      }
    },
    "The requesting service supplied this name; FitKiku has not verified its identity.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это имя указал запрашивающий сервис; FitKiku не подтвердил его подлинность."
          }
        }
      }
    },
    "The server could not confirm the daily update.": {
      "localizations": {

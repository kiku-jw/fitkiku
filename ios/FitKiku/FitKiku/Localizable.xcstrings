{
  "sourceLanguage": "en",
  "strings": {
    "%@ h %@ min": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ h %2$@ min"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ч %2$@ мин"
          }
        }
      }
    },
    "%@ · Steps %@, Sleep %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ · Steps %2$@, Sleep %3$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · Шаги: %2$@, сон: %3$@"
          }
        }
      }
    },
    "8-digit code": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "8-значный код"
          }
        }
      }
    },
    "A legacy recovery link was loaded. Review the server before pairing.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загружена устаревшая ссылка восстановления. Проверьте сервер перед подключением."
          }
        }
      }
    },
    "AI processing": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обработка ИИ"
          }
        }
      }
    },
    "After Apple Health permission and sync, FitKiku sends this server daily Steps, asleep minutes, coverage, and Health source details. Sleep interval times and categories stay on this iPhone.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После разрешения доступа к «Здоровью» и синхронизации FitKiku отправляет на этот сервер дневные данные о шагах, минутах сна, полноте данных и источниках. Время и категории интервалов сна остаются на этом iPhone."
          }
        }
      }
    },
    "Agent fetched": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ассистент получил данные"
          }
        }
      }
    },
    "Agent up to date": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У ассистента свежие данные"
          }
        }
      }
    },
    "Allow Apple Health": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите доступ к «Здоровью»"
          }
        }
      }
    },
    "Anyone with the link can read your recent Steps and Sleep. It cannot write to Apple Health or access other categories.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Любой, у кого есть ссылка, сможет читать ваши недавние данные о шагах и сне. Ссылка не позволяет записывать данные в «Здоровье» или читать другие категории."
          }
        }
      }
    },
    "Apple Health access could not be requested.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось запросить доступ к приложению «Здоровье»."
          }
        }
      }
    },
    "Apple Health is not available on this device.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение «Здоровье» недоступно на этом устройстве."
          }
        }
      }
    },
    "Apple Health is unavailable on this device.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение «Здоровье» недоступно на этом устройстве."
          }
        }
      }
    },
    "Apple Health permission is a separate next step.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешение приложения «Здоровье» запрашивается отдельно на следующем шаге."
          }
        }
      }
    },
    "Apple keeps read-denial status private. Missing data stays Unknown; FitKiku never replaces it with zero.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple не сообщает приложениям об отказе в чтении. Отсутствующие данные остаются неизвестными — FitKiku никогда не подменяет их нулём."
          }
        }
      }
    },
    "Approve connection": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одобрить подключение"
          }
        }
      }
    },
    "Approve this connection": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одобрите подключение"
          }
        }
      }
    },
    "Approved destination": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одобренный сервер"
          }
        }
      }
    },
    "Background delivery could not be registered. Manual sync remains available.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось включить фоновую передачу. Ручная синхронизация по-прежнему доступна."
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмена"
          }
        }
      }
    },
    "ChatGPT or another approved agent fetched the latest server update.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ChatGPT или другой одобренный ассистент получил последние данные с сервера."
          }
        }
      }
    },
    "Check and sync now": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверить и синхронизировать"
          }
        }
      }
    },
    "Check delivery": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверить передачу"
          }
        }
      }
    },
    "Checking…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверяем…"
          }
        }
      }
    },
    "Claimed agent": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заявленный ассистент"
          }
        }
      }
    },
    "Complete": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полные"
          }
        }
      }
    },
    "Connect": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключить"
          }
        }
      }
    },
    "Connect ChatGPT": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключить ChatGPT"
          }
        }
      }
    },
    "Connect the app and request Apple Health access before syncing.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключите приложение и разрешите чтение данных «Здоровья» перед синхронизацией."
          }
        }
      }
    },
    "Connect with recovery code": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключить по коду восстановления"
          }
        }
      }
    },
    "Connected through recovery setup. Review Apple Health access next.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключено через восстановление. Теперь проверьте доступ к приложению «Здоровье»."
          }
        }
      }
    },
    "Connected, but the private ChatGPT link could not be created. Try again below. %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключение готово, но создать приватную ссылку для ChatGPT не удалось. Повторите попытку ниже. %@"
          }
        }
      }
    },
    "Connected. Allow Apple Health next, then copy your private ChatGPT prompt.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключено. Теперь разрешите доступ к «Здоровью», а затем скопируйте готовое сообщение для ChatGPT."
          }
        }
      }
    },
    "Connected. You can now review and grant Apple Health read access.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключено. Теперь можно проверить и разрешить чтение данных «Здоровья»."
          }
        }
      }
    },
    "Connection": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключение"
          }
        }
      }
    },
    "Connection request cancelled.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрос на подключение отменён."
          }
        }
      }
    },
    "Continue to Health": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжить в «Здоровье»"
          }
        }
      }
    },
    "Copy for ChatGPT": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопировать для ChatGPT"
          }
        }
      }
    },
    "Copy one prepared message into an ordinary ChatGPT chat. It includes your private link and asks ChatGPT to fetch it again for every health answer.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопируйте одно готовое сообщение в обычный чат ChatGPT. В нём уже есть ваша приватная ссылка и просьба заново получать данные перед каждым ответом о здоровье."
          }
        }
      }
    },
    "Coverage: Steps %@, Sleep %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Coverage: Steps %1$@, Sleep %2$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полнота данных: шаги — %1$@, сон — %2$@"
          }
        }
      }
    },
    "Create a private link for this connection. It does not expose raw Health data, sources, or write access.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создайте приватную ссылку для этого подключения. Она не открывает сырые данные «Здоровья», источники или доступ на запись."
          }
        }
      }
    },
    "Create my private link": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создать мою приватную ссылку"
          }
        }
      }
    },
    "Create private link": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создать приватную ссылку"
          }
        }
      }
    },
    "Create your private link": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создайте приватную ссылку"
          }
        }
      }
    },
    "Daily Steps and Sleep are connected, but recent delivery status is still unknown.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дневные данные о шагах и сне подключены, но статус недавней передачи пока неизвестен."
          }
        }
      }
    },
    "Daily Steps and Sleep are connected, but some recent delivery still needs attention.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дневные данные о шагах и сне подключены, но недавняя передача требует внимания."
          }
        }
      }
    },
    "Daily Steps and Sleep can go here. Delivery has not been checked yet.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сюда будут поступать дневные данные о шагах и сне. Передача ещё не проверялась."
          }
        }
      }
    },
    "Delete FitKiku account and data": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить аккаунт и данные FitKiku"
          }
        }
      }
    },
    "Delete FitKiku account?": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить аккаунт FitKiku?"
          }
        }
      }
    },
    "Delete account and data": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить аккаунт и данные"
          }
        }
      }
    },
    "Delivery details": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подробности передачи"
          }
        }
      }
    },
    "Delivery has not been checked yet.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Передача ещё не проверялась."
          }
        }
      }
    },
    "Delivery not checked": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Передача не проверена"
          }
        }
      }
    },
    "Delivery status is unavailable. %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Статус передачи недоступен. %@"
          }
        }
      }
    },
    "Delivery status is unavailable. Try again when you're online.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Статус передачи недоступен. Повторите попытку, когда появится интернет."
          }
        }
      }
    },
    "Delivery status unavailable": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Статус передачи недоступен"
          }
        }
      }
    },
    "Destination": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер"
          }
        }
      }
    },
    "Disconnect and revoke server access": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключиться и отозвать доступ"
          }
        }
      }
    },
    "Disconnect the current server before opening another Pair Link.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключите текущий сервер, прежде чем открывать другую ссылку подключения."
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Готово"
          }
        }
      }
    },
    "Enter the current eight-digit recovery code.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите действующий 8-значный код восстановления."
          }
        }
      }
    },
    "Error: %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ошибка: %@"
          }
        }
      }
    },
    "Finish local cleanup": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершить локальную очистку"
          }
        }
      }
    },
    "Finish removing the revoked local credential before connecting again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершите удаление отозванных локальных данных подключения, прежде чем подключаться снова."
          }
        }
      }
    },
    "FitKiku": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "FitKiku"
          }
        }
      }
    },
    "FitKiku asks only for read access to Steps and Sleep. Nothing is written to Apple Health.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "FitKiku запрашивает только чтение данных о шагах и сне. Приложение ничего не записывает в «Здоровье»."
          }
        }
      }
    },
    "FitKiku connects read-only Steps and Sleep to a personal AI agent you approve.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "FitKiku подключает данные о шагах и сне только для чтения к одобренному вами персональному ИИ-ассистенту."
          }
        }
      }
    },
    "FitKiku creates a private link. Then allow Steps and Sleep and copy one prepared message into ChatGPT.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "FitKiku создаст приватную ссылку. Затем разрешите чтение шагов и сна и скопируйте одно готовое сообщение в ChatGPT."
          }
        }
      }
    },
    "FitKiku is already up to date.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В FitKiku уже актуальные данные."
          }
        }
      }
    },
    "FitKiku is up to date.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В FitKiku актуальные данные."
          }
        }
      }
    },
    "FitKiku keeps recent Steps and Sleep behind one private, read-only link. You decide when to share or revoke it.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "FitKiku хранит недавние данные о шагах и сне за одной приватной ссылкой только для чтения. Вы сами решаете, когда поделиться ею или отозвать её."
          }
        }
      }
    },
    "FitKiku private ChatGPT link": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приватная ссылка FitKiku для ChatGPT"
          }
        }
      }
    },
    "FitKiku sends daily Steps, asleep minutes, coverage, and source details only after approval. Sleep interval times stay on this iPhone.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только после вашего одобрения FitKiku отправляет дневные данные о шагах, минутах сна, полноте данных и источниках. Время интервалов сна остаётся на этом iPhone."
          }
        }
      }
    },
    "FitKiku server data and local protected data were deleted. Apple Health was unchanged.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные FitKiku на сервере и защищённые локальные данные удалены. Данные в приложении «Здоровье» не изменились."
          }
        }
      }
    },
    "FitKiku server data was deleted. Local protected-data cleanup is still pending; retry below. %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные FitKiku на сервере удалены. Очистка защищённых локальных данных ещё не завершена; повторите попытку ниже. %@"
          }
        }
      }
    },
    "FitKiku will create a revocable link for recent Steps and Sleep. Anyone with the link can read that summary.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "FitKiku создаст отзывную ссылку на недавнюю сводку о шагах и сне. Любой, у кого есть ссылка, сможет прочитать эту сводку."
          }
        }
      }
    },
    "HTTPS destination": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS-сервер"
          }
        }
      }
    },
    "Health access was requested. Apple keeps read-denial status private.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к «Здоровью» запрошен. Apple не сообщает приложениям об отказе в чтении."
          }
        }
      }
    },
    "Health access was requested. Connect a server later to sync.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к «Здоровью» запрошен. Подключите сервер позже для синхронизации."
          }
        }
      }
    },
    "Health permission required": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужно разрешение «Здоровья»"
          }
        }
      }
    },
    "Health sources on this iPhone: %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Источников данных «Здоровья» на этом iPhone: %@"
          }
        }
      }
    },
    "Help and privacy": {
      "localizations": {
        "ru": {

      }
    },
    "These summaries stay available on this iPhone, even without an agent connection.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти сводки остаются доступными на этом iPhone даже без подключения ассистента."
          }
        }
      }
    },
    "This Pair Link has an invalid or incomplete token.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этой ссылке подключения некорректный или неполный токен."
          }
        }
      }
    },
    "This Pair Link has expired. Ask your agent for a new link.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Срок действия ссылки подключения истёк. Попросите ассистента создать новую."
          }
        }
      }
    },
    "This connection is approved, but delivery status is currently unavailable.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключение одобрено, но статус передачи сейчас недоступен."
          }
        }
      }
    },
    "This destination is approved, but Apple Health permission is still a separate step.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер одобрен, но разрешение приложения «Здоровье» всё ещё нужно выдать отдельно."
          }
        }
      }
    },
    "This older flow does not include the agent's retention or AI-processing disclosure.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этом устаревшем способе подключения нет сведений о сроке хранения и обработке данных ИИ."
          }
        }
      }
    },
    "This permanently deletes the anonymous FitKiku connection, synced summaries, and agent access from the server. It does not delete anything from Apple Health.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это навсегда удалит анонимное подключение FitKiku, синхронизированные сводки и доступ ассистента с сервера. Данные в приложении «Здоровье» не изменятся."
          }
        }
      }
    },
    "This step only approves the destination below. Apple Health permission is still separate.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом шаге вы одобряете только указанный сервер. Разрешение приложения «Здоровье» запрашивается отдельно."
          }
        }
      }
    },
